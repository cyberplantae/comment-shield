# ---- Sign-in password (generated by npm run setup:local) ----
# Keep private. At least 24 characters. Changing it signs out all browsers.
ADMIN_PASSWORD=

# ---- Database ----
DATABASE_URL=postgres://localhost:5432/comment_shield

# ---- Your Meta app (ONE app serves every creator; they never see these) ----
META_APP_ID=
META_APP_SECRET=
# Random string you invent. Paste the same value into the Meta webhook config.
META_WEBHOOK_VERIFY_TOKEN=
# Where Meta sends creators back after they click "Connect Instagram".
# Must be registered verbatim in the Meta app's OAuth redirect allowlist.
PUBLIC_BASE_URL=http://localhost:3188

# Graph API version used for all Instagram/Threads calls.
META_GRAPH_VERSION=v23.0

# ---- Token encryption ----
# 32 bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- The classifier ----
# Which engine reads the comments. Visit /setup for a priced comparison
# of every supported model and how each one does on borderline calls.
#   anthropic = Claude
#   openai    = OpenAI
#   ollama    = a model on this machine. Free, private, weaker.
CLASSIFIER_PROVIDER=anthropic

# -- if CLASSIFIER_PROVIDER=anthropic --
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-opus-5
# Reasoning depth per batch: low | medium | high | xhigh | max
CLASSIFIER_EFFORT=medium

# -- if CLASSIFIER_PROVIDER=openai --
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Override to use an OpenAI-compatible endpoint (Groq, Together, vLLM, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1

# -- if CLASSIFIER_PROVIDER=ollama --
# Install from ollama.com, then: ollama pull llama3.1:8b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
